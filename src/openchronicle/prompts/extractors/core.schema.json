{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenChronicle Core Variadic Extractor Output",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "confidence", "summary", "payload", "source_refs", "links"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["commitment", "person_signal", "decision", "risk", "open_loop"]},
          "status": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "summary": {"type": "string"},
          "payload": {"type": "object"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "links": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
